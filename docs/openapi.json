        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Consultar Tarefa"
      }
    },
    "/v1/tarefas/{id_tarefa}/resultado": {
      "get": {
        "description": "Devolve o resultado de uma tarefa concluída e o apaga da memória.",
        "operationId": "baixar_resultado_v1_tarefas__id_tarefa__resultado_get",
        "parameters": [
          {
            "in": "path",
