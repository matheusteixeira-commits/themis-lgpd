            "description": "Validation Error"
          }
        },
        "summary": "Anonimizar Texto"
      }
    },
    "/v1/arquivos/anonimizar": {
      "post": {
        "description": "Anonimiza um arquivo e devolve o arquivo gerado. Os totais e os avisos são informados nos cabeçalhos `X-Themis-Tarjados`, `X-Themis-Para-Revisar` e `X-Themis-Avisos` (codificado para URL). Campos do formulário (todos opcionais, exceto `arquivo`): `perfil`, `modo`, `permitir` e `bloquear` (repetíveis), `preservar_agentes_publicos`, `coluna_integral` (repetível; planilhas), `ocr` e `resposta` (`arquivo`, padrão, ou `json`, que devolve o arquivo em base64 com o relatório de tarjamento).",
        "operationId": "anonimizar_arquivo_rota_v1_arquivos_anonimizar_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_anonimizar_arquivo_rota_v1_arquivos_anonimizar_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Anonimizar Arquivo Rota"
      }
    },
    "/v1/perfis": {
      "get": {
        "description": "Perfis de anonimização (do Themis e do órgão) e modos de saída.",
        "operationId": "listar_perfis_v1_perfis_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Listar Perfis"
      }
    },
    "/v1/tarefas": {
      "post": {
        "description": "Agenda a anonimização de um arquivo e responde imediatamente (HTTP 202), para documentos longos, como PDFs digitalizados, que excederiam o tempo de uma requisição. Consulte a situação em `GET /v1/tarefas/{id}` e baixe o resultado em `GET /v1/tarefas/{id}/resultado`; o resultado é apagado da memória após o download ou após `THEMIS_TAREFA_TTL_S` segundos. Campos do formulário (todos opcionais, exceto `arquivo`): `perfil`, `modo`, `permitir` e `bloquear` (repetíveis), `preservar_agentes_publicos`, `coluna_integral` (repetível; planilhas), `ocr` e `resposta` (`arquivo`, padrão, ou `json`, que devolve o arquivo em base64 com o relatório de tarjamento).",
        "operationId": "criar_tarefa_v1_tarefas_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_criar_tarefa_v1_tarefas_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Criar Tarefa"
      }
    },
    "/v1/tarefas/{id_tarefa}": {
      "delete": {
        "description": "Apaga a tarefa e o seu resultado; uma análise em andamento termina, mas o resultado é descartado.",
        "operationId": "apagar_tarefa_v1_tarefas__id_tarefa__delete",
        "parameters": [
          {
            "in": "path",
            "name": "id_tarefa",
            "required": true,
            "schema": {
              "title": "Id Tarefa",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Apagar Tarefa"
      },
      "get": {
        "description": "Situação da tarefa: ``na_fila``, ``processando``, ``concluida`` ou ``falhou``.",
        "operationId": "consultar_tarefa_v1_tarefas__id_tarefa__get",
        "parameters": [
          {
            "in": "path",
