          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Baixar Resultado"
      }
    },
    "/v1/tipos": {
      "get": {
        "description": "Tipos de dado reconhecidos, com categoria, etiqueta e base legal.",
        "operationId": "listar_tipos_v1_tipos_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
