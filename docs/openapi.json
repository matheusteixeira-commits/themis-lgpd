        "summary": "Analisar Texto"
      }
    },
    "/v1/anonimizar": {
      "post": {
        "description": "Anonimiza um texto e devolve o texto anonimizado, as entidades e a nota de tarjamento.",
        "operationId": "anonimizar_texto_v1_anonimizar_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PedidoTexto"
              }
