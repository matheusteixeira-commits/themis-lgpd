  "info": {
    "description": "Anonimização de documentos públicos brasileiros (LGPD/LAI). Nada é gravado em disco.",
    "title": "Themis LGPD",
    "version": "1.1.0.dev0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/saude": {
      "get": {
        "description": "Estado do serviço, versão, disponibilidade de OCR e configuração em uso.",
        "operationId": "saude_saude_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Saude"
      }
    },
    "/v1/analisar": {
      "post": {
        "description": "Lista o que seria tarjado ou sinalizado, sem alterar o texto.",
        "operationId": "analisar_texto_v1_analisar_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PedidoTexto"
              }
            }
          },
          "required": true
        },
