{
	email {$EMAIL_ACME}
	order rate_limit before reverse_proxy
	# Sem diretiva "log" no site: o Caddy não grava log de acesso (nenhum IP/URL de visitante armazenado).
}

{$DOMINIO} {
	encode zstd gzip

	# Arquivos até 5 MB na demo (+ margem do multipart)
	request_body {
		max_size 6MB
	}

	# Limite por IP: protege a demo de abuso (CPU) e de varreduras
	rate_limit {
		zone por_ip {
			key {remote_host}
			events 180
			window 1m
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		# img-src sem domínios externos: nenhum conteúdo de documento consegue disparar requisição a terceiros
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss: ws:; worker-src 'self' blob:; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'self'"
		-Server
	}

	reverse_proxy themis:8501
}
